# EditorConfig — consistent formatting across editors. https://editorconfig.org
# Optional: helps contributors, never required to use AI Desk.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: keep trailing whitespace (two spaces = a hard line break).
[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
