# AI Desk — keep the user's private data out of version control.

# The user's saved profile (personal/business data).
profile/profile.md

# Everything the user produces or drops in to work on.
workspace/*
!workspace/README.md

# Local, machine-specific harness state (any AI tool). The shared config is committed;
# the *.local.json overrides are personal and stay out of git.
.claude/settings.local.json
.claude/*.local.json
.opencode/*.local.json

# Secrets — never commit these (defense-in-depth; also denied in settings.json).
.env
.env.*
*.pem
*.key
credentials

# OS / editor noise.
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Node (only if an advanced user adds tooling later).
node_modules/

# opencode auto-generated plugin dependencies, if a plugin is ever added (managed automatically).
.opencode/node_modules/
.opencode/package.json
.opencode/package-lock.json
.opencode/bun.lock
.opencode/.gitignore
